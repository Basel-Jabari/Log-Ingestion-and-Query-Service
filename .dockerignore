# Dependencies and build output — installed / built inside the image
node_modules
dist

# Local secrets and editor state
.env
.vscode

# Git and CI — not needed to build or run the app
.git
.gitattributes
.gitignore
.github
.husky

# Formatting / tooling configs — not used by tsc or node
.nvmrc
